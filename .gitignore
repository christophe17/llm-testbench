# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Notebooks: locally executed outputs, not the checkpoints
.ipynb_checkpoints/

# Data: the public datasets cache is not versioned (data/README.md explains what to version)
data/cache/

# Terraform
**/.terraform/
*.tfstate
*.tfstate.backup
*.tfplan
# The environments' .terraform.lock.hcl files are versioned (multi-platform hashes);
# the bootstrap's (local state, single use) stays ignored.
infra/terraform/bootstrap/.terraform.lock.hcl

# Secrets and local environment
.env
.envrc

# macOS
.DS_Store

# Terraform: tfvars files contain personal values (alert e-mail...)
*.tfvars
