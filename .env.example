# Copier en .env (ignoré par git). Toutes les variables sont optionnelles ; sans clé, seuls
# les tests hors ligne et les notebooks en mode échantillon fonctionnent.

# Clés des providers (lues à l'appel, jamais stockées) — voir config/llm_backends.toml
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Base locale (make k3d-up + make pg-port-forward)
LLM_TESTBENCH_DATABASE_URL=postgresql://testbench:testbench-local-only@localhost:5432/testbench

# Générateur par défaut (sinon defaults.generator du registre)
# LLM_TESTBENCH_CHAT_MODEL=anthropic/claude-sonnet-5

# Traces vers Langfuse local (guide infra 07 : make langfuse-up + make langfuse-port-forward).
# Clés de l'initialisation headless locale — constantes de dev, pas des secrets.
LLM_TESTBENCH_OTLP_ENDPOINT=http://localhost:3000/api/public/otel/v1/traces
LLM_TESTBENCH_LANGFUSE_PUBLIC_KEY=pk-lf-local-0000000000000000
LLM_TESTBENCH_LANGFUSE_SECRET_KEY=sk-lf-local-0000000000000000

# Mode échantillon (CI) : jeux tronqués, aucun chiffre publiable
# LLM_TESTBENCH_SAMPLE=1
