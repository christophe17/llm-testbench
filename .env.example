# Copy to .env (ignored by git). All variables are optional; without a key, only the
# offline tests and the notebooks in sample mode work.

# Provider keys (read at call time, never stored) — see config/llm_backends.toml
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Local database (make k3d-up + make pg-port-forward)
LLM_TESTBENCH_DATABASE_URL=postgresql://testbench:testbench-local-only@localhost:5432/testbench

# Default generator (otherwise defaults.generator from the registry)
# LLM_TESTBENCH_CHAT_MODEL=anthropic/claude-sonnet-5-5

# Traces to local Langfuse (infra guide 07: make langfuse-up + make langfuse-port-forward).
# Keys of the local headless initialization — dev constants, not secrets.
LLM_TESTBENCH_OTLP_ENDPOINT=http://localhost:3000/api/public/otel/v1/traces
LLM_TESTBENCH_LANGFUSE_PUBLIC_KEY=pk-lf-local-0000000000000000
LLM_TESTBENCH_LANGFUSE_SECRET_KEY=sk-lf-local-0000000000000000

# Sample mode (CI): truncated datasets, no publishable numbers
# LLM_TESTBENCH_SAMPLE=1
