# Secrets Manager: the provider keys, created empty here and set by hand (guide 05).
#
# The database URL is no longer composed by Terraform: the password is generated by RDS
# in a managed secret (`manage_master_user_password`, rds.tf) and External Secrets composes
# the URL in the cluster, from that secret and the address passed to the chart
# (templates/externalsecret.yaml). The password goes through neither the Terraform state
# nor a second secret (ADR 009).

resource "aws_secretsmanager_secret" "api_keys" {
  for_each = local.api_secrets

  name                    = "${local.secret_prefix}/${each.key}"
  description             = "${each.value} key of the llm-testbench API (${var.environment})"
  recovery_window_in_days = 0 # immediate destruction with the environment

  tags = {
    Module = "secrets"
  }
}

# Dummy initial value: to be replaced with `aws secretsmanager put-secret-value`.
resource "aws_secretsmanager_secret_version" "api_keys_placeholder" {
  for_each = aws_secretsmanager_secret.api_keys

  secret_id     = each.value.id
  secret_string = "REPLACE_ME"

  lifecycle {
    ignore_changes = [secret_string] # the real value, set by hand, is never overwritten
  }
}
