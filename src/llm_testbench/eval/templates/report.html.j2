<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ suite_name }} — evaluation report</title>
<style>
  :root {
    --page: #f9f9f7; --surface: #fcfcfb; --ink: #0b0b0b; --ink-2: #52514e; --muted: #898781;
    --grid: #e1e0d9; --axis: #c3c2b7; --series: #2a78d6; --hover: #f0efec;
    --good: #006300; --bad: #b3261e;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --page: #0d0d0d; --surface: #1a1a19; --ink: #f0efec; --ink-2: #c3c2b7; --muted: #898781;
      --grid: #2c2c2a; --axis: #383835; --series: #3987e5; --hover: #2c2c2a;
      --good: #0ca30c; --bad: #e66767;
    }
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--page); color: var(--ink);
         font: 15px/1.5 system-ui, -apple-system, "Segoe UI", sans-serif; }
  main { max-width: 1240px; margin: 0 auto; padding: 32px 16px 64px; }
  h1 { font-size: 24px; margin: 0 0 4px; }
  h2 { font-size: 18px; margin: 40px 0 4px; }
  h3 { font-size: 14px; margin: 24px 0 8px; color: var(--ink-2); font-weight: 600; }
  p { margin: 4px 0 12px; max-width: 72ch; }
  .meta, .note { color: var(--ink-2); font-size: 13px; }
  .card { background: var(--surface); border: 1px solid var(--grid); border-radius: 8px;
          padding: 16px; margin-top: 12px; }
  .scroll { overflow-x: auto; }
  svg { display: block; width: 100%; height: auto; min-width: 560px; }
  svg text { font: 12px system-ui, -apple-system, "Segoe UI", sans-serif; fill: var(--ink-2); }
  svg .tick { fill: var(--muted); font-variant-numeric: tabular-nums; }
  svg .arm { fill: var(--ink); }
  .legend { display: flex; flex-wrap: wrap; gap: 6px 20px; font-size: 13px; color: var(--ink-2);
            margin-bottom: 8px; }
  .legend svg { display: inline-block; width: 34px; min-width: 0; height: 12px;
                vertical-align: -1px; margin-right: 6px; }
  .hit { fill: transparent; }
  g.rowmark:hover .hit, g.rowmark:focus .hit { fill: var(--hover); }
  g.rowmark:focus { outline: none; }
  table { border-collapse: collapse; width: 100%; font-size: 13px; }
  th, td { padding: 6px 8px; text-align: right; border-bottom: 1px solid var(--grid);
           white-space: nowrap; font-variant-numeric: tabular-nums; }
  th { color: var(--ink-2); font-weight: 600; }
  th:first-child, td:first-child, td.text, th.text, td.index, th.index { text-align: left; }
  td.text { white-space: normal; min-width: 150px; }
  .good { color: var(--good); } .bad { color: var(--bad); }
  details { margin-top: 12px; font-size: 13px; color: var(--ink-2); }
  details pre { white-space: pre-wrap; margin: 6px 0 0; font-size: 12px; }
  #tip { position: fixed; pointer-events: none; display: none; background: var(--surface);
         border: 1px solid var(--axis); border-radius: 6px; padding: 8px 10px; font-size: 12px;
         box-shadow: 0 2px 10px rgba(0, 0, 0, .15); max-width: 320px; z-index: 10; }
  #tip strong { display: block; font-size: 16px; color: var(--ink);
                font-variant-numeric: tabular-nums; }
  #tip span { display: block; color: var(--ink-2); }
</style>
</head>
<body>
<main>
  <h1>{{ suite_name }}</h1>
  <p>{{ description }}</p>
  <p class="meta">Generated {{ generated_at.strftime("%Y-%m-%d %H:%M UTC") }} from the archived
  runs (<code>data/results/runs/{{ suite_name }}/</code>). Headline metric: nDCG@10, mean over
  the queries with a 95% bootstrap interval (10,000 resamples of the queries).
  {% if missing %}Arms of the suite with no archived run: {{ missing | join(", ") }}.{% endif %}</p>

  {% for section in sections %}
  <h2>{{ section.dataset }}</h2>
  <p class="meta">{{ section.describe.documents }} documents, {{ section.describe.queries }}
  queries, {{ section.describe.judgments }} judgments, split {{ section.describe.split }}.</p>

  <div class="card">
    <div class="legend">
      <span><svg viewBox="0 0 34 12" aria-hidden="true"><line x1="2" y1="6" x2="32" y2="6"
        stroke="var(--series)" stroke-width="2" stroke-linecap="round"/><circle cx="17" cy="6"
        r="5" fill="var(--series)" stroke="var(--surface)" stroke-width="2"/></svg>our nDCG@10,
        with its 95% interval</span>
      <span><svg viewBox="0 0 34 12" aria-hidden="true"><line x1="17" y1="0" x2="17" y2="12"
        stroke="var(--ink)" stroke-width="2"/></svg>reference score (published, or measured
        with another tool)</span>
    </div>
    <div class="scroll">
    {% set panel = section.panel %}
    <svg viewBox="0 0 {{ panel.width }} {{ panel.height }}" role="img"
         aria-label="nDCG@10 of each arm on {{ section.dataset }}, with 95% intervals and reference scores. The table below holds the same values.">
      {% for tick in panel.ticks %}
      <line x1="{{ tick.x }}" y1="0" x2="{{ tick.x }}" y2="{{ panel.plot_bottom }}"
            stroke="var(--grid)" stroke-width="1"/>
      <text class="tick" x="{{ tick.x }}" y="{{ panel.plot_bottom + 17 }}"
            text-anchor="middle">{{ tick.label }}</text>
      {% endfor %}
      <line x1="{{ panel.gutter }}" y1="{{ panel.plot_bottom }}" x2="{{ panel.width }}"
            y2="{{ panel.plot_bottom }}" stroke="var(--axis)" stroke-width="1"/>
      {% for row in panel.rows %}
      <g class="rowmark" tabindex="0"
         data-arm="{{ row.arm }}"
         data-value="{{ '%.3f' | format(row.mean) }}"
         data-interval="95% interval {{ '%.3f' | format(row.low) }} to {{ '%.3f' | format(row.high) }}"
         {% if row.reference %}data-reference="reference {{ '%.3f' | format(row.reference.value) }} ({{ row.reference.label }}), gap {{ '%+.3f' | format(row.reference.gap) }}"{% endif %}>
        <rect class="hit" x="0" y="{{ row.top }}" width="{{ panel.width }}" height="{{ panel.row }}"/>
        <text class="arm" x="{{ panel.gutter - 12 }}" y="{{ row.y + 4 }}"
              text-anchor="end">{{ row.arm }}</text>
        <line x1="{{ row.x_low }}" y1="{{ row.y }}" x2="{{ row.x_high }}" y2="{{ row.y }}"
              stroke="var(--series)" stroke-width="2" stroke-linecap="round"/>
        <circle cx="{{ row.x_mean }}" cy="{{ row.y }}" r="5" fill="var(--series)"
                stroke="var(--surface)" stroke-width="2"/>
        {% if row.reference %}
        <line x1="{{ row.reference.x }}" y1="{{ row.y - 10 }}" x2="{{ row.reference.x }}"
              y2="{{ row.y + 10 }}" stroke="var(--ink)" stroke-width="2"/>
        {% endif %}
      </g>
      {% endfor %}
    </svg>
    </div>
  </div>

  <div class="card scroll">
    <table>
      <thead><tr>
        <th>arm</th><th>nDCG@10</th><th>95% interval</th><th class="text">reference (gap)</th>
        <th>recall@10</th><th>recall@100</th><th>MRR@10</th><th>p50 ms</th><th>p95 ms</th>
        <th>query cost</th><th class="index">index built</th>
      </tr></thead>
      <tbody>
      {% for run in section.runs %}
      {% set m = run.metrics %}
      <tr>
        <td>{{ run.arm }}</td>
        <td><strong>{{ '%.3f' | format(m[headline].mean) }}</strong></td>
        <td>{{ '%.3f' | format(m[headline].low) }} – {{ '%.3f' | format(m[headline].high) }}</td>
        <td class="text">{% for reference in run.references %}{{ '%.3f' | format(reference.value) }}
          {{ reference.label }} ({{ '%+.3f' | format(run.gap(reference)) }}){{ "; " if not loop.last }}{% else %}—{% endfor %}</td>
        <td>{{ '%.3f' | format(m.recall_at_10.mean) if 'recall_at_10' in m else '—' }}</td>
        <td>{{ '%.3f' | format(m.recall_at_100.mean) if 'recall_at_100' in m else '—' }}</td>
        <td>{{ '%.3f' | format(m.mrr_at_10.mean) if 'mrr_at_10' in m else '—' }}</td>
        <td>{{ '%.1f' | format(run.latency_ms.p50) }}</td>
        <td>{{ '%.1f' | format(run.latency_ms.p95) }}</td>
        <td>{{ 'unknown' if run.cost_usd is none else '$%.4f' | format(run.cost_usd) }}</td>
        <td class="index">{% if not run.index %}—{% elif run.retriever.retriever == "bm25" %}{{ run.index.documents }}
          docs, in memory{% elif run.index.chunks_embedded %}{{ run.index.chunks }} chunks,
          {{ 'cost unknown' if run.index.cost_usd is none else '$%.3f' | format(run.index.cost_usd) }},
          {{ '%.0f' | format(run.index.seconds) }} s{% else %}{{ run.index.chunks }} chunks,
          reused{% endif %}</td>
      </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>

  {% if section.comparisons %}
  <h3>Paired comparison with {{ section.comparisons[0].baseline }}, same queries</h3>
  <div class="card scroll">
    <table>
      <thead><tr><th>arm</th><th>Δ nDCG@10</th><th>95% interval of the difference</th>
        <th class="text">verdict</th></tr></thead>
      <tbody>
      {% for row in section.comparisons %}
      <tr>
        <td>{{ row.arm }}</td>
        <td><strong>{{ '%+.3f' | format(row.mean) }}</strong></td>
        <td>{{ '%+.3f' | format(row.low) }} – {{ '%+.3f' | format(row.high) }}</td>
        <td class="text">{% if not row.significant %}no significant difference: the interval
          contains zero{% elif row.mean > 0 %}<span class="good">▲ better</span>, beyond the luck
          of the query sample{% else %}<span class="bad">▼ worse</span>, beyond the luck of the
          query sample{% endif %}</td>
      </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}

  <details>
    <summary>What produced these numbers</summary>
    {% for run in section.runs %}
    <pre><strong>{{ run.arm }}</strong> — run {{ run.run_id }}, commit {{ run.git_sha or "unknown" }}{{ " (uncommitted changes)" if run.git_dirty }}
{% for key, value in run.retriever.items() %}{{ key }} = {{ value }}
{% endfor %}{% for reference in run.references %}reference: {{ reference.value }} {{ reference.label }} — {{ reference.source }}
{% endfor %}</pre>
    {% endfor %}
  </details>
  {% endfor %}

  <p class="note" style="margin-top:40px">Limits, stated: these datasets are public and
  probably in the training data of the models; there is no real traffic behind the latencies,
  which are measured one query at a time from a laptop; an interval describes the luck of the
  query sample, not the errors of the judgments.</p>
</main>
<div id="tip" role="status"><strong></strong><span></span><span></span><span></span></div>
<script>
  (function () {
    var tip = document.getElementById("tip");
    var parts = tip.children;
    function show(mark, x, y) {
      parts[0].textContent = mark.dataset.value;
      parts[1].textContent = mark.dataset.arm;
      parts[2].textContent = mark.dataset.interval;
      parts[3].textContent = mark.dataset.reference || "";
      tip.style.display = "block";
      var width = tip.offsetWidth, height = tip.offsetHeight;
      tip.style.left = Math.max(8, Math.min(x + 14, window.innerWidth - width - 8)) + "px";
      tip.style.top = Math.max(8, Math.min(y + 14, window.innerHeight - height - 8)) + "px";
    }
    function hide() { tip.style.display = "none"; }
    document.querySelectorAll("g.rowmark").forEach(function (mark) {
      mark.addEventListener("pointermove", function (event) {
        show(mark, event.clientX, event.clientY);
      });
      mark.addEventListener("pointerleave", hide);
      mark.addEventListener("focus", function () {
        var box = mark.getBoundingClientRect();
        show(mark, box.left + box.width / 2, box.top);
      });
      mark.addEventListener("blur", hide);
    });
  })();
</script>
</body>
</html>
